{
  "uid": "pm25-serving",
  "title": "PM2.5 Jakarta - Model Serving",
  "tags": [
    "mlflow",
    "pm25",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Replika berhasil di-scrape",
      "type": "stat",
      "description": "Target Prometheus yang UP. Default deployment: 3 replika.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"model-serving\"})",
          "legendFormat": "{{replica}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Total throughput (request/detik)",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(model_inference_requests_total{job=\"model-serving\"}[1m]))",
          "legendFormat": "{{replica}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Request gagal (%)",
      "type": "stat",
      "description": "Semua respons non-2xx, termasuk input tidak valid dan upstream gagal.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(model_inference_requests_total{job=\"model-serving\",status!~\"2..\"}[1m])) / clamp_min(sum(rate(model_inference_requests_total{job=\"model-serving\"}[1m])), 1e-9)",
          "legendFormat": "{{replica}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Rata-rata prediksi (1 menit)",
      "type": "stat",
      "description": "Keluaran model; bukan MAE/RMSE atau pengukuran aktual.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(model_prediction_pm25_ug_m3_sum{job=\"model-serving\"}[1m])) / clamp_min(sum(rate(model_prediction_pm25_ug_m3_count{job=\"model-serving\"}[1m])), 1e-9)",
          "legendFormat": "{{replica}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:µg/m³",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Latensi HTTP inferensi P50/P95 per replika",
      "type": "timeseries",
      "description": "Meliputi proxy, parsing, dan inferensi MLflow; bukan waktu komputasi model saja.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, replica) (rate(model_inference_duration_seconds_bucket{job=\"model-serving\"}[1m])))",
          "legendFormat": "{{replica}} P50",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, replica) (rate(model_inference_duration_seconds_bucket{job=\"model-serving\"}[1m])))",
          "legendFormat": "{{replica}} P95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Distribusi trafik per replika",
      "type": "timeseries",
      "description": "Permintaan benar-benar diarahkan ke setiap replika; tidak ada load balancer pada simulasi ini.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (replica) (rate(model_inference_requests_total{job=\"model-serving\"}[1m]))",
          "legendFormat": "{{replica}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "CPU keluarga proses serving (% satu core)",
      "type": "timeseries",
      "description": "CPU supervisor, gateway, dan proses MLflow turunannya. 100% = satu core; bukan CPU seluruh host/container.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(model_serving_process_cpu_seconds_total{job=\"model-serving\"}[1m])",
          "legendFormat": "{{replica}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "RAM keluarga proses serving (jumlah RSS)",
      "type": "timeseries",
      "description": "Jumlah RSS proses serving; shared pages dapat terhitung berulang. Bukan penggunaan RAM cgroup/container.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "model_serving_process_memory_bytes{job=\"model-serving\"}",
          "legendFormat": "{{replica}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Rata-rata prediksi per replika",
      "type": "timeseries",
      "description": "Perubahan distribusi keluaran merupakan sinyal investigasi, bukan bukti penurunan akurasi.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (replica) (rate(model_prediction_pm25_ug_m3_sum{job=\"model-serving\"}[1m])) / clamp_min(sum by (replica) (rate(model_prediction_pm25_ug_m3_count{job=\"model-serving\"}[1m])), 1e-9)",
          "legendFormat": "{{replica}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:µg/m³",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Distribusi prediksi PM2.5",
      "type": "heatmap",
      "description": "Histogram prediksi selama trafik aktif. Data demo adalah simulasi.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(model_prediction_pm25_ug_m3_bucket{job=\"model-serving\"}[1m]))",
          "legendFormat": "{{le}}",
          "range": true,
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:µg/m³",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges"
        },
        "yAxis": {
          "unit": "suffix:µg/m³"
        },
        "tooltip": {
          "mode": "single",
          "showHistogram": true
        }
      }
    }
  ],
  "annotations": {
    "list": []
  }
}
